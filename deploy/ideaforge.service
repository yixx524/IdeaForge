[Unit]
Description=IdeaForge Spring Boot Application
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=ideaforge
Group=ideaforge
WorkingDirectory=/opt/ideaforge
EnvironmentFile=/opt/ideaforge/.env
ExecStart=/usr/bin/java -Xms256m -Xmx512m -jar /opt/ideaforge/IdeaForge-0.0.1-SNAPSHOT.jar
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
